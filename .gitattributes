# Shell scripts: enforce LF (avoid CRLF syntax errors on target)
*.sh text eol=lf

*.pdf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.itb filter=lfs diff=lfs merge=lfs -text
*mfgtool* filter=lfs diff=lfs merge=lfs -text
# Build entry points are source, even when their names contain "mfgtool".
scripts/kas-build-mfgtools.sh -filter -diff -merge text eol=lf
fitImage-* filter=lfs diff=lfs merge=lfs -text
