[Unit]
Description=Waydroid container on Jaguar Screen
Requires=waydroid-image-provision.service
After=waydroid-image-provision.service dbus.service
ConditionPathExists=/var/lib/waydroid/images/system.img
ConditionPathExists=/var/lib/waydroid/images/vendor.img

[Service]
Type=simple
ExecStartPre=/usr/libexec/waydroid-jaguar-vpu-prepare
ExecStart=/usr/bin/waydroid container start
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
